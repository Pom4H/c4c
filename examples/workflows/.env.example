# Copy to .env.local and set a random value (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Never use NEXT_PUBLIC_ for this token. No credential is embedded in the browser.
C4C_ADMIN_TOKEN=
# Local World is the default for development. Leave target unset on Vercel.
# For self-hosted Postgres only, use .env.postgres.example instead.
