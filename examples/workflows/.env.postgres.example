C4C_ADMIN_TOKEN=
POSTGRES_PASSWORD=
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
# Set the same password as POSTGRES_PASSWORD; do not rely on interpolation by node --env-file.
WORKFLOW_POSTGRES_URL=postgres://c4c:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/c4c_workflow
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=5
WORKFLOW_POSTGRES_MAX_POOL_SIZE=10
