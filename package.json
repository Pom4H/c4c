{
  "name": "c4c",
  "version": "0.3.0",
  "private": true,
  "description": "c4c - Workflow DevKit for TypeScript (powered by useworkflow.dev)",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm exec vitest run",
    "test:integration": "cd tests/workflow-integration && pnpm exec vitest run",
    "c4c": "pnpm exec c4c",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@c4c/cli": "workspace:*",
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.22"
  },
  "dependencies": {
    "workflow": "4.1.0-beta.54",
    "@workflow/world-local": "4.1.0-beta.30"
  }
}
